10. Código completo

Juntando todas as etapas, temos:

import random
import time


def particionar(vetor, inicio, fim):
    indice = random.randint(inicio, fim)
    vetor[indice], vetor[fim] = vetor[fim], vetor[indice]

    pivo = vetor[fim]
    i = inicio - 1

    for j in range(inicio, fim):
        if vetor[j] <= pivo:
            i += 1
            vetor[i], vetor[j] = vetor[j], vetor[i]

    vetor[i + 1], vetor[fim] = vetor[fim], vetor[i + 1]

    return i + 1


def quicksort(vetor, inicio, fim):
    while inicio < fim:
        pivo = particionar(vetor, inicio, fim)

        if pivo - inicio < fim - pivo:
            quicksort(vetor, inicio, pivo - 1)
            inicio = pivo + 1
        else:
            quicksort(vetor, pivo + 1, fim)
            fim = pivo - 1


tempos = []

for i in range(3):
    vetor = [
        random.randint(1, 100000)
        for _ in range(100000)
    ]

    inicio = time.perf_counter()

    quicksort(vetor, 0, len(vetor) - 1)

    fim = time.perf_counter()

    tempo = fim - inicio
    tempos.append(tempo)

    print(f"Execução {i + 1}: {tempo:.6f} segundos")

    # Confere se o vetor está ordenado
    assert all(
        vetor[j] <= vetor[j + 1]
        for j in range(len(vetor) - 1)
    )

media = sum(tempos) / len(tempos)

print(f"\nTempo médio: {media:.6f} segundos")

Adicionamos uma verificação com "assert" para confirmar que o vetor foi ordenado corretamente. Essa verificação acontece depois da medição e não interfere no tempo registrado.

